rules_version = '2';

// LUMIO SALON - Firestore güvenlik kuralları (5. teslim, ek)
// Kural özeti:
//  - Bir salonun verisini yalnızca o salonun AKTİF üyeleri okur.
//  - Yazma için salonun lisansı (deneme ya da aktif) geçerli olmalı.
//  - Yönetici belgesi hiçbir zaman değiştirilemez ve silinemez.
//  - Kıdemli yetkiliyi yalnızca yönetici ekler, pasif yapar ya da rolünü değiştirir.
//  - Hiçbir üye belgesi silinemez (pasif yapılır); işlem kayıtları değiştirilemez ve silinemez.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Yardımcılar ----
    function girisli() {
      return request.auth != null;
    }

    function kullaniciYolu(uid) {
      return /databases/$(database)/documents/kullanicilar/$(uid);
    }

    function salonYolu(salonId) {
      return /databases/$(database)/documents/salons/$(salonId);
    }

    // Giriş yapan kişinin üyelik belgesi
    function ben() {
      return get(kullaniciYolu(request.auth.uid)).data;
    }

    function uyeMi(salonId) {
      return girisli()
        && exists(kullaniciYolu(request.auth.uid))
        && ben().salonId == salonId
        && ben().aktif == true;
    }

    // Yönetici ve kıdemli yetkili
    function yetkiliMi(salonId) {
      return uyeMi(salonId) && ben().rol in ['yonetici', 'kidemli'];
    }

    // Maliyet ve kayıtları görebilenler: yönetici, kıdemli yetkili, ortak
    function gorenMi(salonId) {
      return uyeMi(salonId) && ben().rol in ['yonetici', 'kidemli', 'ortak'];
    }

    // Lisans: deneme süresi SUNUCU saatine göre, aktif lisans bitiş tarihine göre
    function lisansAktif(salonId) {
      let s = get(salonYolu(salonId)).data;
      return (s.durum == 'AKTIF' && s.bitisMs > request.time.toMillis())
        || (s.durum == 'DENEME' && request.time < s.olusturma + duration.value(14, 'd'));
    }


    // Bu kişi (uid) aynı salonun üyesi mi?
    function uyeSalonda(salonId, uid) {
      return exists(kullaniciYolu(uid)) && get(kullaniciYolu(uid)).data.salonId == salonId;
    }

    function hizmetGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ad', 'kategori', 'fiyat', 'sure', 'asamalar', 'aktif', 'guncelleme'])
        && d.ad is string && d.ad.size() >= 2 && d.ad.size() <= 60
        && d.kategori is string && d.kategori.size() <= 40
        && d.fiyat is number && d.fiyat >= 0 && d.fiyat <= 1000000
        && d.sure is int && d.sure >= 5 && d.sure <= 600
        && d.asamalar is list && d.asamalar.size() <= 6
        && d.aktif is bool
        && d.guncelleme == request.time;
    }

    function ustaGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(['calisir', 'hizmetler', 'mesai', 'izinler', 'guncelleme'])
        && d.calisir is bool
        && d.hizmetler is list && d.hizmetler.size() <= 200
        && d.mesai is map && d.mesai.keys().hasOnly(['pzt', 'sal', 'car', 'per', 'cum', 'cmt', 'paz'])
        && d.izinler is list && d.izinler.size() <= 100
        && d.guncelleme == request.time;
    }


    function randevuYolu(salonId, rid) {
      return /databases/$(database)/documents/salons/$(salonId)/randevular/$(rid);
    }

    function kilitYolu(salonId, kid) {
      return /databases/$(database)/documents/salons/$(salonId)/slotlar/$(kid);
    }

    // Randevu yazabilenler: yönetici, kıdemli yetkili, sekreter, usta (ortak yalnız görür)
    function randevuYazar(salonId) {
      return uyeMi(salonId) && ben().rol in ['yonetici', 'kidemli', 'sekreter', 'usta'];
    }


    function ayarYolu(salonId, ayarId) {
      return /databases/$(database)/documents/salons/$(salonId)/ayarlar/$(ayarId);
    }

    function odemeYolu(salonId, oid) {
      return /databases/$(database)/documents/salons/$(salonId)/odemeler/$(oid);
    }

    // Şu anki hesap dönemi (Hesabı kapat her seferinde 1 artırır). Hiç kapatılmadıysa 0.
    function suankiDonem(salonId) {
      return exists(ayarYolu(salonId, 'kapanis')) ? get(ayarYolu(salonId, 'kapanis')).data.donem : 0;
    }

    // Ödeme alabilenler: yönetici, kıdemli yetkili, sekreter
    function odemeYazar(salonId) {
      return uyeMi(salonId) && ben().rol in ['yonetici', 'kidemli', 'sekreter'];
    }

    function randevuTemel() {
      let d = request.resource.data;
      return d.musteriAd is string && d.musteriAd.size() >= 2 && d.musteriAd.size() <= 60
        && d.musteriTel is string && d.musteriTel.size() <= 20
        && d.not is string && d.not.size() <= 200
        && d.tarih is string && d.tarih.size() == 10
        && d.bas is int && d.bas >= 0 && d.bas < 1440
        && d.bit is int && d.bit > d.bas && d.bit <= 1440
        && d.kalemler is list && d.kalemler.size() >= 1 && d.kalemler.size() <= 6
        && d.kilitler is list && d.kilitler.size() >= 1 && d.kilitler.size() <= 400
        && (!('ustalar' in d) || (d.ustalar is list && d.ustalar.size() <= 6))
        && (!('musteriId' in d) || d.musteriId is string)
        && d.guncelleme == request.time;
    }

    // ---- Üyeler (kullanicilar/{uid}) ----
    match /kullanicilar/{uid} {
      allow read: if girisli() && (request.auth.uid == uid || uyeMi(resource.data.salonId));

      allow create: if girisli()
        && request.resource.data.keys().hasOnly(['salonId', 'ad', 'telefon', 'rol', 'aktif', 'olusturma', 'ekleyen', 'yasalOnay'])
        && request.resource.data.ad is string
        && request.resource.data.ad.size() >= 2
        && request.resource.data.ad.size() <= 60
        && request.resource.data.telefon is string
        && request.resource.data.aktif == true
        && request.resource.data.olusturma == request.time
        && (
          // 1) Salonu kuran kişi: aynı işlemde salon belgesi de oluşturulur ve sahibi kendisidir
          (
            request.auth.uid == uid
            && request.resource.data.rol == 'yonetici'
            && request.resource.data.ekleyen == uid
            && existsAfter(salonYolu(request.resource.data.salonId))
            && getAfter(salonYolu(request.resource.data.salonId)).data.ownerUid == uid
          )
          ||
          // 2) Yönetici ya da kıdemli yetkili yeni kişi ekliyor
          (
            uid != request.auth.uid
            && !exists(kullaniciYolu(uid))
            && request.resource.data.ekleyen == request.auth.uid
            && yetkiliMi(request.resource.data.salonId)
            && lisansAktif(request.resource.data.salonId)
            && (
              (ben().rol == 'yonetici' && request.resource.data.rol in ['kidemli', 'ortak', 'sekreter', 'usta'])
              || (ben().rol == 'kidemli' && request.resource.data.rol in ['ortak', 'sekreter', 'usta'])
            )
          )
        );

      // Rol, aktiflik ve ad değişimi. Yönetici belgesine kimse dokunamaz;
      // kıdemli yetkiliye yalnızca yönetici dokunabilir.
      allow update: if yetkiliMi(resource.data.salonId)
        && lisansAktif(resource.data.salonId)
        && uid != request.auth.uid
        && resource.data.rol != 'yonetici'
        && (resource.data.rol != 'kidemli' || ben().rol == 'yonetici')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol', 'aktif', 'ad'])
        && request.resource.data.ad is string
        && request.resource.data.ad.size() >= 2
        && request.resource.data.ad.size() <= 60
        && (
          (ben().rol == 'yonetici' && request.resource.data.rol in ['kidemli', 'ortak', 'sekreter', 'usta'])
          || (ben().rol == 'kidemli' && request.resource.data.rol in ['ortak', 'sekreter', 'usta'])
        );

      allow delete: if false;
    }

    // ---- Salon ----
    match /salons/{salonId} {
      allow read: if uyeMi(salonId);

      // Salon yalnızca kurucunun üyelik belgesiyle AYNI işlemde kurulabilir (boş salon yığılmasın)
      allow create: if girisli()
        && request.resource.data.keys().hasOnly(['ad', 'ownerUid', 'durum', 'paket', 'olusturma'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.durum == 'DENEME'
        && request.resource.data.paket == 'salon'
        && request.resource.data.olusturma == request.time
        && request.resource.data.ad is string
        && request.resource.data.ad.size() >= 2
        && request.resource.data.ad.size() <= 80
        && !exists(kullaniciYolu(request.auth.uid))
        && existsAfter(kullaniciYolu(request.auth.uid))
        && getAfter(kullaniciYolu(request.auth.uid)).data.salonId == salonId;

      // Şimdilik yalnızca salon adı değişebilir; lisans alanlarını yalnızca Firebase konsolundan sen değiştirirsin
      allow update: if yetkiliMi(salonId)
        && lisansAktif(salonId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ad'])
        && request.resource.data.ad is string
        && request.resource.data.ad.size() >= 2
        && request.resource.data.ad.size() <= 80;

      allow delete: if false;

      // ---- İşlem kayıtları: yalnız eklenir, değiştirilemez, silinemez ----
      match /kayitlar/{kayitId} {
        allow read: if gorenMi(salonId);
        allow create: if uyeMi(salonId)
          && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['uid', 'islem', 'hedef', 'ayrinti', 'zaman'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.zaman == request.time;
        allow update, delete: if false;
      }

      // ---- Genel ayarlar (POS oranı, randevu adımı) ve hesap dönemi sayacı ----
      match /ayarlar/{ayarId} {
        allow read: if uyeMi(salonId);
        allow create, update: if yetkiliMi(salonId) && lisansAktif(salonId)
          && (
            (
              ayarId == 'genel'
              && request.resource.data.keys().hasOnly(['posOrani', 'randevuAdimi', 'salonTel', 'kayipGun', 'guncelleme'])
              && request.resource.data.posOrani is number
              && request.resource.data.posOrani >= 0 && request.resource.data.posOrani <= 20
              && request.resource.data.randevuAdimi in [5, 10, 15, 20, 30, 60]
              && request.resource.data.salonTel is string && request.resource.data.salonTel.size() <= 30
              && request.resource.data.kayipGun is int && request.resource.data.kayipGun >= 7 && request.resource.data.kayipGun <= 730
              && request.resource.data.guncelleme == request.time
            )
            ||
            (
              ayarId == 'kapanis'
              && request.resource.data.keys().hasOnly(['donem', 'guncelleme'])
              && request.resource.data.donem is int
              && request.resource.data.donem == suankiDonem(salonId) + 1
              && request.resource.data.guncelleme == request.time
            )
          );
        allow delete: if false;
      }

      // ---- Hizmetler (silinmez, pasif yapılır) ----
      match /hizmetler/{hizmetId} {
        allow read: if uyeMi(salonId);
        allow create, update: if yetkiliMi(salonId) && lisansAktif(salonId) && hizmetGecerli();
        allow delete: if false;
      }

      // ---- Usta profili: çalışma durumu, hizmetleri, mesai, izin (salondaki herkes okur) ----
      match /ustalar/{ustaUid} {
        allow read: if uyeMi(salonId);
        allow create, update: if yetkiliMi(salonId) && lisansAktif(salonId)
          && uyeSalonda(salonId, ustaUid) && ustaGecerli();
        allow delete: if false;
      }

      // ---- Usta payı ve ürün primi: yalnız yönetici, kıdemli, ortak ve ustanın kendisi okur ----
      match /ustaMali/{ustaUid} {
        allow read: if gorenMi(salonId) || (uyeMi(salonId) && request.auth.uid == ustaUid);
        allow create, update: if yetkiliMi(salonId) && lisansAktif(salonId)
          && uyeSalonda(salonId, ustaUid)
          && request.resource.data.keys().hasOnly(['yuzde', 'urunPrimi', 'guncelleme'])
          && request.resource.data.yuzde is number
          && request.resource.data.yuzde >= 0 && request.resource.data.yuzde <= 100
          && request.resource.data.urunPrimi is number
          && request.resource.data.urunPrimi >= 0 && request.resource.data.urunPrimi <= 100
          && request.resource.data.guncelleme == request.time;
        allow delete: if false;
      }

      // ---- Randevular (silinmez, iptal edilir) ----
      // "kilitler": randevunun tuttuğu ustanın 5 dakikalık dilimlerinin belge adları.
      // Her kilit ayrı bir belgedir; aynı adlı belge ikinci kez OLUŞTURULAMAZ. Çakışma kilidini sunucu böyle sağlar.
      match /randevular/{rid} {
        // Usta, müşteri adlarını yalnızca kendi randevularında görür. Diğer ustaların dolu saatlerini "slotlar"dan görür.
        allow read: if uyeMi(salonId)
          && (ben().rol in ['yonetici', 'kidemli', 'ortak', 'sekreter'] || request.auth.uid in resource.data.ustalar);
        allow create: if randevuYazar(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['musteriAd', 'musteriTel', 'musteriId', 'ustalar', 'tarih', 'bas', 'bit', 'kalemler', 'kilitler', 'durum', 'not', 'olusturan', 'olusturma', 'guncelleme'])
          && request.resource.data.durum == 'bekliyor'
          && request.resource.data.olusturan == request.auth.uid
          && request.resource.data.olusturma == request.time
          && randevuTemel()
          && existsAfter(kilitYolu(salonId, request.resource.data.kilitler[0]));
        allow update: if (
            // 1) düzenleme / erteleme / iptal
            randevuYazar(salonId) && lisansAktif(salonId)
            && resource.data.durum == 'bekliyor'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['musteriAd', 'musteriTel', 'musteriId', 'ustalar', 'tarih', 'bas', 'bit', 'kalemler', 'kilitler', 'durum', 'not', 'iptalNedeni', 'guncelleme'])
            && request.resource.data.durum in ['bekliyor', 'iptal']
            && randevuTemel()
            && (request.resource.data.durum == 'iptal' || existsAfter(kilitYolu(salonId, request.resource.data.kilitler[0])))
          ) || (
            // 2) ödeme alındı: aynı işlemde ödeme belgesi de oluşur
            odemeYazar(salonId) && lisansAktif(salonId)
            && resource.data.durum == 'bekliyor'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'odemeId', 'guncelleme'])
            && request.resource.data.durum == 'odendi'
            && request.resource.data.odemeId is string
            && existsAfter(odemeYolu(salonId, request.resource.data.odemeId))
            && request.resource.data.guncelleme == request.time
          ) || (
            // 3) ödeme iptal edildi: randevu yeniden "bekliyor" olur
            yetkiliMi(salonId) && lisansAktif(salonId)
            && resource.data.durum == 'odendi'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'odemeId', 'guncelleme'])
            && request.resource.data.durum == 'bekliyor'
            && request.resource.data.odemeId == ''
            && request.resource.data.guncelleme == request.time
          ) || (
            // 4) eski kayıtları yeni düzene çevirme: yalnız "ustalar" alanı eklenir
            yetkiliMi(salonId) && lisansAktif(salonId)
            && !('ustalar' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ustalar', 'guncelleme'])
            && request.resource.data.ustalar is list && request.resource.data.ustalar.size() <= 6
            && request.resource.data.guncelleme == request.time
          );
        allow delete: if false;
      }

      match /slotlar/{kid} {
        allow read: if uyeMi(salonId);
        allow create: if randevuYazar(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['rid', 'ustaUid', 'tarih'])
          && request.resource.data.rid is string
          && existsAfter(randevuYolu(salonId, request.resource.data.rid))
          && kid in getAfter(randevuYolu(salonId, request.resource.data.rid)).data.kilitler
          && request.resource.data.tarih == getAfter(randevuYolu(salonId, request.resource.data.rid)).data.tarih;
        allow update: if false;
        allow delete: if randevuYazar(salonId) && lisansAktif(salonId);
      }

      // ---- Ödemeler: yalnız eklenir; iptal edilince durum "iptal" olur, silinmez ----
      match /odemeler/{oid} {
        // Usta bu belgeyi okuyamaz (başka ustaların tutarları da içinde); kendi satırlarını "ustaSatirlari"ndan okur.
        allow read: if uyeMi(salonId) && ben().rol in ['yonetici', 'kidemli', 'ortak', 'sekreter'];
        allow create: if odemeYazar(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['rid', 'musteriId', 'tarih', 'donem', 'yontem', 'musteriAd', 'kalemler', 'ustalar', 'toplam', 'komisyonOrani', 'komisyon', 'durum', 'alan', 'zaman'])
          && request.resource.data.durum == 'gecerli'
          && request.resource.data.alan == request.auth.uid
          && request.resource.data.zaman == request.time
          && request.resource.data.yontem in ['nakit', 'kart']
          && request.resource.data.tarih is string && request.resource.data.tarih.size() == 10
          && request.resource.data.donem == suankiDonem(salonId)
          && request.resource.data.toplam is number && request.resource.data.toplam >= 0 && request.resource.data.toplam <= 10000000
          && request.resource.data.komisyon is number && request.resource.data.komisyon >= 0 && request.resource.data.komisyon <= request.resource.data.toplam
          && request.resource.data.komisyonOrani is number
          && request.resource.data.komisyonOrani == (request.resource.data.yontem == 'kart' && exists(ayarYolu(salonId, 'genel')) ? get(ayarYolu(salonId, 'genel')).data.posOrani : 0)
          && request.resource.data.kalemler is list && request.resource.data.kalemler.size() >= 1 && request.resource.data.kalemler.size() <= 12
          && request.resource.data.ustalar is list && request.resource.data.ustalar.size() <= 12
          && request.resource.data.musteriAd is string && request.resource.data.musteriAd.size() <= 60
          && request.resource.data.rid is string
          && request.resource.data.musteriId is string
          && (request.resource.data.rid == '' || existsAfter(randevuYolu(salonId, request.resource.data.rid)));
        // Yalnızca iptal: yönetici / kıdemli, yalnızca içinde bulunulan dönemdeki ödeme
        allow update: if yetkiliMi(salonId) && lisansAktif(salonId)
          && resource.data.durum == 'gecerli'
          && resource.data.donem == suankiDonem(salonId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'iptalNedeni'])
          && request.resource.data.durum == 'iptal'
          && request.resource.data.iptalNedeni is string && request.resource.data.iptalNedeni.size() <= 100;
        allow delete: if false;
      }

      // ---- Ustanın kendi ödeme satırları: her ustanın yalnız kendi kazanç satırı (başkasının tutarını göremez) ----
      match /ustaSatirlari/{sid} {
        allow read: if gorenMi(salonId) || (uyeMi(salonId) && resource.data.ustaUid == request.auth.uid);
        allow create: if odemeYazar(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['ustaUid', 'odemeId', 'tarih', 'donem', 'musteriAd', 'ad', 'tutar', 'alis', 'tur', 'yontem', 'komisyonOrani', 'durum'])
          && request.resource.data.durum == 'gecerli'
          && request.resource.data.donem == suankiDonem(salonId)
          && request.resource.data.ustaUid is string
          && request.resource.data.tutar is number && request.resource.data.tutar >= 0
          && request.resource.data.alis is number && request.resource.data.alis >= 0
          && request.resource.data.tur in ['hizmet', 'urun']
          && request.resource.data.yontem in ['nakit', 'kart']
          && request.resource.data.odemeId is string
          && existsAfter(odemeYolu(salonId, request.resource.data.odemeId))
          && request.resource.data.ustaUid in getAfter(odemeYolu(salonId, request.resource.data.odemeId)).data.ustalar;
        allow update: if yetkiliMi(salonId) && lisansAktif(salonId)
          && resource.data.durum == 'gecerli'
          && resource.data.donem == suankiDonem(salonId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum'])
          && request.resource.data.durum == 'iptal';
        allow delete: if false;
      }

      // ---- İşlem kayıtları: müşterinin her hizmetindeki formül ve not ----
      // Usta yalnız kendi kayıtlarını yazar/okur. Yönetici ve kıdemli hepsini yazar, ortak okur. Sekreter göremez.
      match /islemler/{iid} {
        allow read: if gorenMi(salonId) || (uyeMi(salonId) && resource.data.ustaUid == request.auth.uid);
        allow create, update: if uyeMi(salonId) && lisansAktif(salonId)
          && (ben().rol in ['yonetici', 'kidemli'] || (ben().rol == 'usta' && request.resource.data.ustaUid == request.auth.uid))
          && request.resource.data.keys().hasOnly(['musteriId', 'ustaUid', 'rid', 'tarih', 'hizmet', 'formul', 'not', 'guncelleme'])
          && request.resource.data.musteriId is string
          && request.resource.data.ustaUid is string
          && request.resource.data.rid is string
          && request.resource.data.tarih is string && request.resource.data.tarih.size() == 10
          && request.resource.data.hizmet is string && request.resource.data.hizmet.size() <= 60
          && request.resource.data.formul is string && request.resource.data.formul.size() <= 500
          && request.resource.data.not is string && request.resource.data.not.size() <= 300
          && request.resource.data.guncelleme == request.time
          && (request.method == 'create' || (resource.data.ustaUid == request.resource.data.ustaUid && resource.data.rid == request.resource.data.rid));
        allow delete: if false;
      }

      // ---- Avans (düzeltme için eksi tutar girilebilir; değiştirilmez, silinmez) ----
      match /avanslar/{aid} {
        allow read: if gorenMi(salonId) || (uyeMi(salonId) && resource.data.ustaUid == request.auth.uid);
        allow create: if yetkiliMi(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['ustaUid', 'tutar', 'tarih', 'donem', 'not', 'veren', 'zaman'])
          && uyeSalonda(salonId, request.resource.data.ustaUid)
          && request.resource.data.tutar is number && request.resource.data.tutar != 0
          && request.resource.data.tutar >= -1000000 && request.resource.data.tutar <= 1000000
          && request.resource.data.tarih is string && request.resource.data.tarih.size() == 10
          && request.resource.data.donem == suankiDonem(salonId)
          && request.resource.data.not is string && request.resource.data.not.size() <= 100
          && request.resource.data.veren == request.auth.uid
          && request.resource.data.zaman == request.time;
        allow update, delete: if false;
      }

      // ---- Akşam mutabakatı: usta kendi gününü onaylar ya da itiraz eder ----
      match /mutabakat/{mid} {
        allow read: if gorenMi(salonId) || (uyeMi(salonId) && resource.data.ustaUid == request.auth.uid);
        allow create, update: if uyeMi(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['ustaUid', 'tarih', 'durum', 'not', 'tutar', 'guncelleme'])
          && request.resource.data.ustaUid == request.auth.uid
          && mid == request.auth.uid + '_' + request.resource.data.tarih
          && request.resource.data.tarih is string && request.resource.data.tarih.size() == 10
          && request.resource.data.durum in ['onay', 'itiraz']
          && request.resource.data.not is string && request.resource.data.not.size() <= 200
          && request.resource.data.tutar is number
          && request.resource.data.guncelleme == request.time;
        allow delete: if false;
      }

      // ---- Ustanın dönemden devreden borcu (yalnız Hesabı kapat yazar) ----
      match /ustaDevir/{ustaUid} {
        allow read: if gorenMi(salonId) || (uyeMi(salonId) && request.auth.uid == ustaUid);
        allow create, update: if yetkiliMi(salonId) && lisansAktif(salonId)
          && uyeSalonda(salonId, ustaUid)
          && request.resource.data.keys().hasOnly(['devir', 'guncelleme'])
          && request.resource.data.devir is number && request.resource.data.devir <= 0 && request.resource.data.devir >= -10000000
          && request.resource.data.guncelleme == request.time;
        allow delete: if false;
      }

      // ---- Kapanmış dönemlerin dökümü ----
      match /donemler/{did} {
        allow read: if gorenMi(salonId);
        allow create: if yetkiliMi(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['donem', 'ustalar', 'toplam', 'kapatan', 'zaman'])
          && request.resource.data.donem == suankiDonem(salonId)
          && request.resource.data.ustalar is list && request.resource.data.ustalar.size() <= 50
          && request.resource.data.kapatan == request.auth.uid
          && request.resource.data.zaman == request.time;
        allow update, delete: if false;
      }

      // ---- Ortak müşteri defteri ----
      // Belge adı telefon numarasıdır (telefonu olmayanlarda rastgele); böylece aynı telefon iki kez açılamaz.
      // "ustalar": müşteriye hizmet vermiş / randevu almış ustalar. Usta yalnızca adının geçtiği müşterileri listeler.
      match /musteriler/{mid} {
        allow get: if uyeMi(salonId);
        allow list: if uyeMi(salonId)
          && (ben().rol in ['yonetici', 'kidemli', 'ortak', 'sekreter'] || request.auth.uid in resource.data.ustalar);
        allow create: if randevuYazar(salonId) && lisansAktif(salonId)
          && request.resource.data.keys().hasOnly(['ad', 'tel', 'not', 'dogum', 'sonraki', 'sonZiyaret', 'ustalar', 'olusturan', 'olusturma', 'guncelleme'])
          && request.resource.data.ad is string && request.resource.data.ad.size() >= 2 && request.resource.data.ad.size() <= 60
          && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
          && (request.resource.data.tel == '' || mid == request.resource.data.tel)
          && request.resource.data.not is string && request.resource.data.not.size() <= 500
          && request.resource.data.dogum is string && request.resource.data.dogum.matches('^$|^[0-3][0-9][.][01][0-9]$')
          && request.resource.data.sonraki is string && request.resource.data.sonraki.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.sonZiyaret is string && request.resource.data.sonZiyaret.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.ustalar is list && request.resource.data.ustalar.size() <= 30
          && request.resource.data.olusturan == request.auth.uid
          && request.resource.data.olusturma == request.time
          && request.resource.data.guncelleme == request.time;
        allow update: if randevuYazar(salonId) && lisansAktif(salonId)
          && request.resource.data.guncelleme == request.time
          && (
            // 1) randevu alınırken usta eklenir (hiçbir usta çıkarılamaz)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ustalar', 'guncelleme'])
              && request.resource.data.ustalar.hasAll(resource.data.ustalar)
              && request.resource.data.ustalar.size() <= 30
            )
            ||
            // 2) bilgi / not düzenleme (usta yalnızca kendi müşterisinde)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ad', 'tel', 'not', 'dogum', 'sonraki', 'guncelleme'])
              && request.resource.data.dogum is string && request.resource.data.dogum.matches('^$|^[0-3][0-9][.][01][0-9]$')
              && request.resource.data.sonraki is string && request.resource.data.sonraki.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.ad is string && request.resource.data.ad.size() >= 2 && request.resource.data.ad.size() <= 60
              && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
              && (request.resource.data.tel == resource.data.tel || resource.data.tel == '')
              && request.resource.data.not is string && request.resource.data.not.size() <= 500
              && (ben().rol != 'usta' || request.auth.uid in resource.data.ustalar)
            )
            ||
            // 3) ödeme alınınca son ziyaret ve (varsa) sonraki ziyaret önerisi işlenir
            (
              odemeYazar(salonId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sonZiyaret', 'sonraki', 'guncelleme'])
              && request.resource.data.sonZiyaret.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.sonraki.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            )
          );
        allow delete: if false;
      }
    }

    // ---- Geri kalan her şey kapalı ----
    match /{diger=**} {
      allow read, write: if false;
    }
  }
}
